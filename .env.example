# Database (Docker Compose PostgreSQL)
# The app connects on port 5434 to avoid conflicts with local PostgreSQL on 5432 and other docker containers on 5433
DATABASE_URL="postgresql://panenka:panenka_dev_password@127.0.0.1:5434/panenka_dev"

# Read-only database URL for MCP server (uses a restricted role)
DATABASE_URL_READONLY="postgresql://panenka_readonly:panenka_readonly_password@127.0.0.1:5434/panenka_dev"

# Node environment
NODE_ENV="development"

# Next.js
NEXT_TELEMETRY_DISABLED=1

# Minimum appearances for rate-based rankings (default: 3)
MIN_APPEARANCES_FOR_RATE=3
